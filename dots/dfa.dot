digraph DFA {
  rankdir=LR;
  node [shape=circle];
  "1" [label="1"] [shape=circle];
  "2" [label="2"] [shape=circle];
  "0" [label="0"] [shape=circle,color=green,style=filled,fillcolor=lightgreen];
  "0" -> "1" [label="'a'"];
  "0" -> "2" [label="'b'"];
  "1" -> "1" [label="'a'"];
  "1" -> "2" [label="'b'"];
  "2" -> "1" [label="'a'"];
  "2" -> "2" [label="'b'"];
}
